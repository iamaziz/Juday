{
  "build": {
    "beforeDevCommand": "npm run next:dev",
    "beforeBuildCommand": "npm run next:build",
    "devPath": "http://localhost:3000",
    "distDir": "../out",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Juday",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "sh.dyad.juday",
      "icon": [
        "../public/Juday-logo-simple.png"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Juday",
        "width": 1024,
        "height": 768
      }
    ]
  }
}